# =====================================================================
# IMIZI Backend Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=5000
# Origin(s) allowed to call the API and open the Socket.IO connection. In
# production this MUST be the exact deployed frontend origin, or every request
# fails with a browser CORS error. Comma-separated for staging + production:
#   CLIENT_URL=https://imizi.vercel.app,https://imizi.rw
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# --- Refresh cookie ---
# Same site (one origin, or app.example.com + api.example.com): lax.
# Different sites (app.vercel.app + api.onrender.com): none, which browsers
# only accept together with COOKIE_SECURE=true over HTTPS.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=imizi_user
DB_PASSWORD=your_database_password
DB_NAME=imizi_db
DB_CONNECTION_LIMIT=10

# --- JWT ---
# Generate strong random secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=<openssl rand -base64 64>
JWT_REFRESH_SECRET=<openssl rand -base64 64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Auth0 (optional social / enterprise sign-in) ---
# Leave these blank to disable it: the API then answers /api/auth/auth0 with
# 503 and the frontend hides the "Continue with Auth0" buttons. Password login
# is unaffected either way.
#
# AUTH0_DOMAIN is the tenant domain *without* https:// (e.g. imizi.eu.auth0.com).
# AUTH0_API_AUDIENCE is the API Identifier of the custom API in Auth0 - not the
# SPA client id. Access tokens are validated against it, so it must match the
# frontend's VITE_AUTH0_AUDIENCE exactly.
#
# Setup: Auth0 Dashboard -> Applications -> Create Application -> Single Page
# Web, then create an API (Auth0 Dashboard -> Applications -> APIs), allow the
# offline_access grant on it, and add these URLs to the SPA application:
#   Allowed Callback URLs:   http://localhost:5173/callback, https://your-site/callback
#   Allowed Logout URLs:     http://localhost:5173, https://your-site
#   Allowed Web Origins:     http://localhost:5173, https://your-site
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=

# --- Email ---
# EMAIL_PROVIDER selects the transport: `resend` (a transactional provider's
# HTTPS API - the production path) or `smtp` (any relay through Nodemailer).
# Leave it unset to infer: Resend when RESEND_API_KEY is set, otherwise SMTP.
# With neither configured, emails are logged to the console instead of sent, so
# local development needs no email credentials at all.
EMAIL_PROVIDER=resend

# Resend (https://resend.com) - free tier: 3,000 emails/month, 100/day.
#   1. Create an API key:              https://resend.com/api-keys
#   2. Add a sending domain and publish the SPF/DKIM records shown for it
#   3. Point EMAIL_FROM at an address on that verified domain. Until you do,
#      onboarding@resend.dev only delivers to your own Resend account address.
RESEND_API_KEY=
EMAIL_FROM="IMIZI Garden Studio <onboarding@resend.dev>"
# EMAIL_REPLY_TO=support@example.com

# --- SMTP relay (used when EMAIL_PROVIDER=smtp) ---
# Works with any provider's relay - smtp.resend.com (username `resend`, password =
# your Resend API key), smtp.postmarkapp.com, ... - a self-hosted mail server, or
# a capture tool such as Mailtrap for staging. Gmail is fine for local testing,
# but a personal mailbox is not a production sender: use Resend in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: extra CA certificate(s) (PEM, comma-separated) for the SMTP TLS
# connection. Only needed when something inspects TLS locally - antivirus mail
# scanning, a corporate proxy, a self-hosted mail server with a private CA.
# Without it such a setup fails with "self-signed certificate in certificate
# chain", because Node uses its own root store and ignores the OS one.
# Find the culprit:  openssl s_client -connect $SMTP_HOST:$SMTP_PORT -starttls smtp 2>&1 | grep -i issuer
# Export it:         powershell "Get-ChildItem Cert:\LocalMachine\Root | ? { $_.Subject -match 'NAME' } | % { '-----BEGIN CERTIFICATE-----'; [Convert]::ToBase64String($_.RawData,'InsertLineBreaks'); '-----END CERTIFICATE-----' }" > certs/root-ca.pem
# SMTP_CA_FILE=./certs/root-ca.pem

# Stripe and PayPal are not currently wired to backend routes.

# --- PayPal (sandbox REST v2 - get credentials at developer.paypal.com) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# --- MTN Mobile Money (Rwanda - get subscription key at momodeveloper.mtn.com,
#     subscribe to "Collections", then run `node scripts/provision-momo.js`
#     once to generate MTN_MOMO_API_USER / MTN_MOMO_API_KEY)
#     Set MTN_MOMO_ENVIRONMENT=production for live Rwanda payments (uses RWF).
#     Sandbox uses EUR by default; production uses RWF.) ---
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=production

# Flutterwave is not currently wired to backend routes.

# Simulated successful MoMo payments are only available outside production,
# and require this explicit opt-in. Production always requires real credentials.
PAYMENTS_SIMULATION_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=10

# --- File uploads ---
# Local disk is used by default (UPLOAD_DIR). To use S3-compatible object
# storage instead (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO),
# set S3_BUCKET (and S3_ENDPOINT for non-AWS providers) - storageService.js
# switches automatically, no code changes needed.
#
# On a container host, uploaded files are destroyed with the container on every
# deploy, and the database is then left pointing at images that 404. Attach a
# volume and this is picked up automatically (Railway sets
# RAILWAY_VOLUME_MOUNT_PATH), or point UPLOAD_DIR at the mount path yourself.
# The most durable option is object storage: set the S3_* values below.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
# S3_BUCKET=imizi-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=                      # set for R2/Spaces/MinIO, leave blank for real AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=               # CDN/custom domain in front of the bucket, if any
# S3_PUBLIC_READ=true

# --- 2FA ---
TWO_FACTOR_APP_NAME=IMIZI Garden Studio
