# =====================================================================
# IMIZI Backend Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=imizi_user
DB_PASSWORD=12345678
DB_NAME=imizi_db
DB_CONNECTION_LIMIT=10

# --- JWT ---
# Generate strong random secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=<openssl rand -base64 64>
JWT_REFRESH_SECRET=<openssl rand -base64 64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email (Nodemailer / SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kayirangaaboubakar360@gmail.com
SMTP_PASSWORD=ykdxjdukiffqsios
EMAIL_FROM="IMIZI Garden Studio <kayirangaaboubakar360@gmail.com>"

# --- Stripe (TEST MODE KEYS ONLY) ---
STRIPE_SECRET_KEY=sk_test_your_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key

# --- PayPal (sandbox REST v2 - get credentials at developer.paypal.com) ---
PAYPAL_CLIENT_ID=sandbox_client_id
PAYPAL_CLIENT_SECRET=sandbox_client_secret
PAYPAL_MODE=sandbox

# --- MTN Mobile Money (Rwanda - get subscription key at momodeveloper.mtn.com,
#     subscribe to "Collections", then run `node scripts/provision-momo.js`
#     once to generate MTN_MOMO_API_USER / MTN_MOMO_API_KEY)
#     Set MTN_MOMO_ENVIRONMENT=production for live Rwanda payments (uses RWF).
#     Sandbox uses EUR by default; production uses RWF.) ---
MTN_MOMO_SUBSCRIPTION_KEY=291594f37be343ed8bd090f0e42785cb
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=production

# --- Flutterwave (Rwanda gateway: MTN Mobile Money, Airtel Money, cards, and
#     bank transfer all in one - get test keys at dashboard.flutterwave.com
#     under Settings > API. FLUTTERWAVE_SECRET_HASH is a secret string YOU
#     choose and paste into the same dashboard's webhook settings page, so
#     Flutterwave sends it back on every webhook call for us to verify.) ---

FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_SECRET_HASH=your_flutterwave_secret_hash_here

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=10

# --- File uploads ---
# Local disk is used by default (UPLOAD_DIR). To use S3-compatible object
# storage instead (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO),
# set S3_BUCKET (and S3_ENDPOINT for non-AWS providers) - storageService.js
# switches automatically, no code changes needed.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
# S3_BUCKET=imizi-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=                      # set for R2/Spaces/MinIO, leave blank for real AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=               # CDN/custom domain in front of the bucket, if any
# S3_PUBLIC_READ=true

# --- 2FA ---
TWO_FACTOR_APP_NAME=IMIZI Garden Studio
