# Copy to .env.local for a build that talks to a deployed backend.
#
# This is baked into the bundle at build time (`vite build`), so it must be set
# in the environment of the build that produces the deployed site - editing it
# afterwards changes nothing until you rebuild.
#
# Use the API's origin only; `/api` is appended by the app. Leave it unset to
# call the same origin the site is served from (what `npm run dev` proxies).
# VITE_API_URL=https://imizi-api.onrender.com
